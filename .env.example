# Copy to .env and fill in real values. Never commit .env.
#
# Generate strong random strings with:
#   openssl rand -hex 32

# ─── Postgres (used by Evolution API) ──────────────────────────────────
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=changeme_strong_password

# ─── Evolution API ─────────────────────────────────────────────────────
# Admin key used in the `apikey` header for all Evolution API calls.
EVOLUTION_API_KEY=changeme_long_random_string
# Name of the WhatsApp instance Evolution will manage.
EVOLUTION_INSTANCE_NAME=shopping

# ─── Python app ────────────────────────────────────────────────────────
# Secret path token: Evolution posts to /webhook/<this>. Anyone hitting
# the app with a different token is rejected.
WEBHOOK_TOKEN=changeme_long_random_path_token

# Whitelisted WhatsApp sender numbers (digits only, no '+', no spaces).
# E.g. Swiss number +41 79 123 45 67 → 41791234567
ALLOWED_NUMBERS=41791234567,41797654321

# ─── AI (Google Gemini) ────────────────────────────────────────────────
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=changeme_google_ai_studio_key
# Optional: override the model (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash
